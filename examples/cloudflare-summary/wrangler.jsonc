{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "public-summary-learning",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "MODEL_API_BASE": "https://replace-with-approved-provider.example/v1",
    "MODEL_ID": "replace-with-actual-model-id",
    "REQUESTS_PER_HOUR": "20"
  },
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "RequestBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RequestBudget"] }]
}
